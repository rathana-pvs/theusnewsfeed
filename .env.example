# Database Connection
DATABASE_URI=postgresql://user:password@host:port/database

# Payload CMS
PAYLOAD_SECRET=your-payload-secret-here

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://key:secret@cloud

# Site Metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=The US News Feed
NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Supabase (Frontend Integration)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini AI (Content Writing Assistant)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Adskeeper — theusnewsfeed.com (site 1122897)
NEXT_PUBLIC_ADS_KEEPER_SCRIPT_URL=https://jsc.adskeeper.com/site/1122897.js
# Feed widget "bottom_feed" (2131114): end of article, home and category pages
NEXT_PUBLIC_ADS_KEEPER_HOME_BOTTOM=2131114
NEXT_PUBLIC_ADS_KEEPER_CATEGORY_BOTTOM=2131114
NEXT_PUBLIC_ADS_KEEPER_ARTICLE_BOTTOM=2131114
# Feed widget also closes search results (shown once all results are loaded)
NEXT_PUBLIC_ADS_KEEPER_SEARCH_FEED=2131114
# In-Article widget "in_article_1" (2131117): after paragraphs 2 and 4 of
# articles, and mid-list on the home and category pages
NEXT_PUBLIC_ADS_KEEPER_WIDGET_IN_ARTICLE_1=2131117
NEXT_PUBLIC_ADS_KEEPER_WIDGET_IN_ARTICLE_2=2131117
NEXT_PUBLIC_ADS_KEEPER_HOME_FEED=2131117
NEXT_PUBLIC_ADS_KEEPER_CATEGORY_FEED=2131117
NEXT_PUBLIC_ADS_KEEPER_WIDGET_IN_ARTICLE_3=
# Sidebar widget "sidebar" (2131124): article page sidebar (desktop)
NEXT_PUBLIC_ADS_KEEPER_ARTICLE_SIDEBAR=2131124
# Exit Feed "full_exit" (2131130): every page, opens on exit intent
NEXT_PUBLIC_ADS_KEEPER_EXIT_FEED=2131130
# Not created yet for this site (leave blank; create a widget to enable)
NEXT_PUBLIC_ADS_KEEPER_MOBILE_TOASTER=


# Adskeeper reporting API (read-only, used by `npm run ads:report`; never commit real values)
ADSKEEPER_API_TOKEN=
ADSKEEPER_AUTH_ID=
# ADSKEEPER_TIMEZONE=Asia/Phnom_Penh

# Ads are hidden site-wide unless this is true
NEXT_PUBLIC_ADS_ENABLED=true
